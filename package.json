{
  "name": "nicotube-studio",
  "version": "0.2.2",
  "private": true,
  "description": "YouTube & Twitch livestream/clip downloader with Niconico-authentic danmaku compositing and hardware-accelerated encoding.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite --port 5173 --strictPort",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron . --dev",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "build:ui": "vite build",
    "start": "npm run build:ui && electron .",
    "dist:win": "npm run build:ui && electron-builder --win"
  },
  "build": {
    "appId": "com.nicotubestudio.app",
    "productName": "NicoTube Studio",
    "publish": [
      {
        "provider": "github",
        "owner": "tomotora1223",
        "repo": "NicoTubeStudio"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "dist-ui/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist/nicotube-backend",
        "to": "backend"
      },
      {
        "from": "backend/bin",
        "to": "bin"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "NicoTubeStudio-${version}-Portable.exe"
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "electron-updater": "^6.8.11",
    "hls.js": "^1.7.4",
    "lucide-react": "^0.511.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.2",
    "electron": "^35.2.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "wait-on": "^8.0.3"
  }
}
